<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.aviantdev.composeextract</id>
    <name>compose-extract</name>
    <vendor>aviant-dev</vendor>
    <description><![CDATA[
        <p><b>compose-extract</b> is an Android Studio plugin that helps developers analyze and extract Jetpack Compose functions using Kotlin PSI and reference APIs.</p>
        <p>Requires Android Studio Ladybug 2024.2.1 or IntelliJ IDEA 2024.2.1, with the bundled Kotlin plugin enabled and the IDE's bundled Java 21 runtime. Supports Kotlin K1 and K2 modes.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true" />
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <intentionAction>
            <className>com.github.aviantdev.composeextract.intentions.ExtractComposableIntention</className>
            <category>Compose</category>
            <descriptionDirectoryName>ExtractComposableIntention</descriptionDirectoryName>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
    </extensions>

    <actions>
        <action id="ComposeExtract.ExtractComposable"
                class="com.github.aviantdev.composeextract.actions.ExtractComposableAction"
                text="Extract Composable function"
                description="Extract the current Compose selection into a new composable">
            <add-to-group group-id="IntroduceActionsGroup" anchor="after" relative-to-action="ExtractMethod"/>
            <add-to-group group-id="Floating.CodeToolbar.Extract" anchor="after" relative-to-action="ExtractMethod"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt E"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt E"/>
        </action>
    </actions>

</idea-plugin>
